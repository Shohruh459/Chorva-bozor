# Supabase loyihasi sozlamalari (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx
# Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=xxxxx

# Telegram bot (@BotFather orqali yarating; keyin /setdomain buyrug'i bilan
# saytingiz domenini bot bilan bog'lang — Telegram Login Widget shuni talab qiladi)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ChorvaBozorBot

# Admin panelga (/admin) kirish huquqi shu Telegram ID'ga beriladi
ADMIN_TELEGRAM_ID=123456789
